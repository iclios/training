<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Écran 1 : configuration -->
    <LinearLayout
        android:id="@+id/screenConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_config"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/config_help"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/gateway_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/gatewayUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.x.x:3789"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnScanConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_scan_config" />

        <TextView
            android:id="@+id/configStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Écran 2 : 2 onglets + 1 scan + 1 payer -->
    <LinearLayout
        android:id="@+id/screenPay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/payTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_pay"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/payGateway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#5A6B7C" />

        <Button
            android:id="@+id/btnReconfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="@string/btn_reconfig" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <ScrollView
                android:id="@+id/panelQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="#F0F6FB">

                    <TextView
                        android:id="@+id/decodedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/decoded_placeholder"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/payloadText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/panelWallet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="#EAF6F3">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_help"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/dpan_label"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/dpanInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DPAN…"
                        android:inputType="text"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/crypt_label"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/cryptInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cryptogramme"
                        android:inputType="textCapCharacters"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/amount_label"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/amountInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="9"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_scan" />

        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_pay" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
